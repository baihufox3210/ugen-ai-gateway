# Application
APP_NAME=UGen AI Gateway
APP_ENV=development

# Required when APP_ENV=production. Sent as the X-API-Key header.
GATEWAY_API_KEY=
# Per client IP, within the rolling window below.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Required local OpenAI-compatible model endpoint (example: Ollama)
LOCAL_API_KEY=local
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5:7b

# Optional cloud provider. Leave both values blank to disable cloud routing.
# When enabled, use a model name supported by your provider.
CLOUD_API_KEY=
CLOUD_BASE_URL=
CLOUD_MODEL=

# Request analysis: hybrid (default), llm, or rules. See README.
ANALYSIS_MODE=hybrid
ANALYSIS_CACHE_SIZE=256
ANALYSIS_CACHE_TTL_SECONDS=600

# Personal-data handling. Cloud requests are always redacted.
REDACT_LOCAL=true
RESTORE_REDACTED=true

# Provider client settings
REQUEST_TIMEOUT=60
MAX_RETRIES=2
